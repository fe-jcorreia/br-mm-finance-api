{
	"$schema": "https://biomejs.dev/schemas/2.1.2/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"includes": ["**", "!**/node_modules/*"]
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [[":NODE:", ":PACKAGE:"], ":BLANK_LINE:", [":ALIAS:", ":PATH:"]]
					}
				}
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"lineWidth": 120,
		"lineEnding": "lf",
		"attributePosition": "multiline",
		"bracketSpacing": true
	},
	"linter": {
		"rules": {
			"complexity": {
				"noUselessTypeConstraint": "off",
				"noForEach": "off",
				"noStaticOnlyClass": "off",
				"noExtraBooleanCast": "off",
				"noBannedTypes": "warn"
			},
			"suspicious": {
				"noConsole": "warn",
				"noExplicitAny": "off",
				"noArrayIndexKey": "off"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useImportType": "off",
				"noImplicitBoolean": "off",
				"noParameterAssign": "off",
				"noUselessElse": "off"
			},
			"correctness": {
				"useExhaustiveDependencies": "warn",
				"useHookAtTopLevel": "error",
				"noUnusedImports": "error",
				"noUnusedVariables": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"bracketSameLine": true,
			"bracketSpacing": true,
			"trailingCommas": "all",
			"arrowParentheses": "asNeeded"
		},
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	}
}
